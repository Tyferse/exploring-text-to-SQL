{
  "general": {
    "input_data_root": "Spider2/spider2-lite",
    "tasks": "spider2-lite_wo_bq.jsonl",
    "run_name": "exec_explore"
  },
  "preprocessing": {
    "spider2preprocess": {
      "is_multidialect": true,
      "max_workers": 8
    }
  },
  "schema_linking": {
    "model": { 
      "model_name": "Qwen3.6-27B", 
      "base_url": "http://localhost:8101/v1",
      "api_key": null,
      "temperature": 0.0
    },
    "ColumnLinking": {
      "max_schema_length": 64000,
      "max_workers": 4,
      "max_columns": null
    },
    "TableColumnLinking": {
      "max_schema_length": 64000,
      "max_columns": null,
      "max_tables": null,
      "max_workers": 6
    },
    "BidirectionalLinking": {
      "max_schema_length": 64000,
      "max_columns": null,
      "max_tables": null,
      "max_workers": 6,
      "cleanup_intermediate": true, 
      "require_both_success": false
    },
    "generate_schemas": {
      "included": "selected",
      "target_max_tokens": 64000
    }
  },
  "dbc_retrieval": {
    "model": { 
      "model_name": "Qwen3.6-27B", 
      "base_url": "http://localhost:8101/v1",
      "api_key": null,
      "temperature": 0.0
    },
    "exploratory_execution": {
      "prompt_name": "exploratory_execution",
      "max_queries": 10,
      "max_rows": 20,
      "max_workers": 6
    }
  },
  "generation": {
    "model": { 
      "model_name": "Qwen3.6-27B", 
      "base_url": "http://localhost:8101/v1",
      "api_key": null,
      "temperature": 1.0
    },
    "simple_generation": {
      "schema_dir": "final_schema",
      "prompt_name":"gen_basic",
      "n_candidates": 1,
      "prefix": "one_step",
      "max_workers": 6,
      "max_schema_tokens": 64000,
      "chars_per_token": 3.0
    }
  }
}